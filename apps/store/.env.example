# Copy to .env (git-ignored) and fill in. Both are baked into the bundle at
# build time — a rebuild is required for a change to take effect.

# Backend base URL. Defaults to https://api.mioru.store when unset.
VITE_API_URL=http://localhost:8000

# Telegram bot handle (no @) backing the Login Widget. Required for a
# production build: without it customers cannot link Telegram and the order
# gate rejects every checkout. Must be the same bot whose token the backend
# holds in TELEGRAM_BOT_TOKEN, or the widget's signature will not verify.
VITE_TELEGRAM_BOT_NAME=mioru_bot
